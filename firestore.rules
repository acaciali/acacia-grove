rules_version = '2';

// Month Money rules.
// History is append-only: undo creates a *new* reversing entry rather than
// editing/deleting an existing one. Chores are fully mutable so we can
// rename, retire (archive), and adjust amounts.
service cloud.firestore {
  match /databases/{database}/documents {
    match /chores/{id} {
      allow read, create, update, delete: if true;
    }

    match /buckets/{id} {
      allow read, create, update, delete: if true;
    }

    // Tombstones written when a bucket is deleted, so the monthly summary can
    // still show what was closed out. Append-only like history.
    match /bucketTombstones/{id} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /history/{id} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Aggregated balances (one doc per user+bucket). Written atomically with
    // each history entry; recompute rewrites them from full history.
    match /balances/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /groceries/{id} {
      allow read, create, update, delete: if true;
    }

    match /counters/{id} {
      allow read, create, update, delete: if true;
    }

    // Finalized per-user monthly totals (one doc per user+month), written by
    // the lazy backfill once a month completes. Never deleted; updates stay
    // allowed so a recompute can correct a month.
    match /monthlySummaries/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /todos/{id} {
      allow read, create, update, delete: if true;
    }

    // Packing list: master items, trips, and per-trip packed state.
    match /packingItems/{id} {
      allow read, create, update, delete: if true;
    }

    match /trips/{id} {
      allow read, create, update, delete: if true;
    }

    match /tripItems/{id} {
      allow read, create, update, delete: if true;
    }
  }
}
